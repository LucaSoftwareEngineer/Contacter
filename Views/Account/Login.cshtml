@model Contacter.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center align-items-center auth-wrapper">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
        <div class="card auth-card">
            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">
                    <div class="auth-icon mx-auto mb-3">
                        <i class="bi bi-person-lock"></i>
                    </div>
                    <h2 class="auth-title mb-1">Bentornato</h2>
                    <p class="text-muted mb-0">Accedi per gestire i tuoi contatti</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success d-flex align-items-center gap-2 py-2" role="alert">
                        <i class="bi bi-check-circle-fill"></i>
                        <div>@TempData["SuccessMessage"]</div>
                    </div>
                }

                <form asp-action="Login" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-medium"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="nome@esempio.it" autocomplete="email" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-medium"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                            <button type="button" class="btn btn-toggle-password" id="togglePassword" aria-label="Mostra o nascondi password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 btn-pill">
                        Accedi <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </form>

                <hr class="my-4" />

                <p class="text-center text-muted mb-0">
                    Non hai un account?
                    <a asp-action="Register" class="fw-semibold text-decoration-none">Registrati qui</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const input = document.getElementById('Password');
            const icon = this.querySelector('i');
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        });
    </script>
}